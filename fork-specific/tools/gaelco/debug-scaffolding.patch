+// TEMP debug aid: ATV_TAP="w:18047000-1804d000,r:14000000-140000ff,cpu=sub|main" logs accesses with context
+void atvtrack_state::install_debug_taps()
+{
+	const char *env = getenv("ATV_TAP");
+	if (!env)
+		return;
+	std::string spec(env);
+	size_t pos = 0;
+	while (pos < spec.size())
+	{
+		size_t end = spec.find(',', pos);
+		if (end == std::string::npos)
+			end = spec.size();
+		std::string item = spec.substr(pos, end - pos);
+		pos = end + 1;
+		bool sub = true;
+		if (item.rfind("m", 0) == 0) { sub = false; item.erase(0, 1); }
+		if (item.size() < 3 || item[1] != ':')
+			continue;
+		char kind = item[0];
+		unsigned lo = 0, hi = 0;
+		if (sscanf(item.c_str() + 2, "%x-%x", &lo, &hi) != 2)
+			continue;
+		address_space &space = (sub ? m_subcpu : m_maincpu)->space(AS_PROGRAM);
+		const char *who = sub ? "SUB" : "MAIN";
+		if (kind == 'w')
+			space.install_write_tap(lo, hi, "tapw", [this, who, sub](offs_t offset, u64 &data, u64 mem_mask)
+			{
+				u32 addr = offset; int lane = ACCESSING_BITS_0_31 ? 0 : 4;
+				u32 val = ACCESSING_BITS_0_31 ? u32(data) : u32(data >> 32);
+				logerror("TAP %s W %08x = %08x (mask %016x) %s pr=%08x\n", who, addr + lane, val, mem_mask, machine().describe_context(), u32((sub ? m_subcpu : m_maincpu)->state_int(SH4_PR)));
+			});
+		else if (kind == 'c')
+			space.install_write_tap(lo, hi, "tapc", [this, sub](offs_t offset, u64 &data, u64 mem_mask)
+			{
+				const u64 key = (u64((sub ? m_subcpu : m_maincpu)->pc()) << 32) | u32((sub ? m_subcpu : m_maincpu)->state_int(SH4_PR));
+				m_tapcount[key]++;
+			});
+		else if (kind == 'r')
+			space.install_read_tap(lo, hi, "tapr", [this, who, sub](offs_t offset, u64 &data, u64 mem_mask)
+			{
+				u32 addr = offset; int lane = ACCESSING_BITS_0_31 ? 0 : 4;
+				u32 val = ACCESSING_BITS_0_31 ? u32(data) : u32(data >> 32);
+				logerror("TAP %s R %08x = %08x (mask %016x) %s pr=%08x\n", who, addr + lane, val, mem_mask, machine().describe_context(), u32((sub ? m_subcpu : m_maincpu)->state_int(SH4_PR)));
+			});
+	}
+}
