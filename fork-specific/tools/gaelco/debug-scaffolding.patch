+void atvtrack_state::install_pc_hook()
+{
+	// TEMP debug aid: ATV_HOOK="8c008442,8c001e82" logs the sub CPU registers when it executes one of these PCs
+	const char *env = getenv("ATV_HOOK");
+	if (!env)
+		return;
+	std::vector<u32> pcs;
+	std::string spec(env);
+	size_t pos = 0;
+	while (pos < spec.size())
+	{
+		size_t end = spec.find(',', pos);
+		if (end == std::string::npos) end = spec.size();
+		pcs.push_back(strtoul(spec.substr(pos, end - pos).c_str(), nullptr, 16));
+		pos = end + 1;
+	}
+	g_sh4_debug_pc_hook = [this, pcs](const void *dev, offs_t curpc)
+	{
+		if (dev == static_cast<const device_t *>(m_maincpu.target()))
+		{
+			// main CPU: only a short log (ATV_HOOKMAIN=1)
+			if (getenv("ATV_HOOKMAIN"))
+				for (u32 p : pcs)
+					if (curpc == p)
+						logerror("HOOKM %08x fr4=%08x r4=%08x r5=%08x r6=%08x pr=%08x\n", curpc, u32(m_maincpu->state_int(SH4_FR4)), u32(m_maincpu->state_int(SH4_R4)), u32(m_maincpu->state_int(SH4_R5)), u32(m_maincpu->state_int(SH4_R6)), u32(m_maincpu->state_int(SH4_PR)));
+			return;
+		}
+		if (dev != static_cast<const device_t *>(m_subcpu.target()) || getenv("ATV_HOOKMAIN"))
+			return;
+		for (u32 p : pcs)
+			if (curpc == p)
+			{
+				auto R = [this](int r) { return u32(m_subcpu->state_int(r)); };
+				logerror("HOOK %08x r0=%08x r1=%08x r2=%08x r3=%08x r4=%08x r5=%08x r6=%08x r7=%08x r8=%08x r9=%08x r10=%08x r11=%08x r12=%08x r13=%08x r14=%08x r15=%08x pr=%08x\n", curpc,
+						R(SH4_R0), R(SH4_R1), R(SH4_R2), R(SH4_R3), R(SH4_R4), R(SH4_R5), R(SH4_R6), R(SH4_R7), R(SH4_R8), R(SH4_R9), R(SH4_R10), R(SH4_R11), R(SH4_R12), R(SH4_R13), R(SH4_R14), R(SH4_R15), R(SH4_PR));
+				if (getenv("ATV_HOOKMEM"))
+				{
+					// dump 16 words at r5 and at r14 (object pointers)
+					address_space &sp = m_subcpu->space(AS_PROGRAM);
+					for (int reg : { int(SH4_R5), int(SH4_R14) })
+					{
+						u32 a = R(reg) & 0x1fffffff;
+						if (a < 0x0c000000 || a >= 0x0d000000) continue;
+						logerror("HOOKMEM %08x [r%d=%08x]:", curpc, reg == int(SH4_R5) ? 5 : 14, a);
+						for (int i = 0; i < 16; i++) logerror(" %08x", sp.read_dword(a + i * 4));
+						logerror("\n");
+					}
+				}
+			}
+	};
+}
